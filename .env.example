APP_ENV=development
APP_SECRET_KEY=replace-with-a-cryptographically-random-secret
DATABASE_URL=sqlite:///./portal.db
# Point to an approved de-identified schema and data package kept outside this repository.
DATASET_SCHEMA_PATH=/secure/path/to/schema.json
DATASET_PACKAGE_PATH=/secure/path/to/dataset.json
# Optional: audited value-catalog CSVs held outside this repository.
VALUE_CATALOG_DIR=/secure/path/to/value-catalog
SESSION_HTTPS_ONLY=false
